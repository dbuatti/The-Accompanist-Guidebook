{
  "manifest_version": 3,
  "name": "The Audition Guidebook",
  "version": "1.0.0",
  "description": "Companion extension for The Audition Guidebook — quick access to your course, progress tracking, and audition tools.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.theauditionguidebook.com/*",
    "https://theauditionguidebook.com/*",
    "https://theauditionguidebook.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "The Audition Guidebook",
    "default_icon": "icons/icon-16.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.theauditionguidebook.com/modules*",
        "https://theauditionguidebook.com/modules*",
        "https://theauditionguidebook.vercel.app/modules*",
        "http://localhost:3000/modules*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
